# Directorio base para montaje de modelos
MODEL_DIR_BASE=./models

# Model IDs de SkyReels
SKYREELS_I2V_MODEL_ID=/models/SkyReels-V2-I2V-1.3B-540P-Diffusers
SKYREELS_DF_MODEL_ID=/models/SkyReels-V2-DF-1.3B-540P-Diffusers

# Perfil automático de offload (auto o force)
DEFAULT_OFFLOAD_MODE=auto

# Calidad de FFmpeg
FFMPEG_CRF=18

# Cache de HuggingFace interna al contenedor
HF_HOME=/models/.cache/huggingface
